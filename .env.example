# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Smart Custody Wallet (Date-Coin) ───────────────────────────
# Watch-only merchant deposit addresses. The platform NEVER custodies real
# crypto — it only verifies inbound payments on-chain. Supply real addresses.
MERCHANT_XRP_ADDRESS=     # XRP/RLUSD destination address (PENDING_USER_ADDRESS until set)
MERCHANT_BTC_ADDRESS=     # BTC destination address (PENDING_USER_ADDRESS until set)
ADMIN_EMAIL=              # Email of the owner allowed to view the treasury admin summary

# ── Auth: password reset email (Resend) ─────────────────────────
RESEND_API_KEY=           # Resend API key (https://resend.com) — leave empty to disable reset emails
EMAIL_FROM=               # Verified sender, e.g. "Resonance <no-reply@yourdomain.com>"
APP_URL=                  # Public base URL (e.g. https://app.yourdomain.com) — used for reset links/OAuth defaults

# ── Auth: Google social login ────────────────────────────────────
GOOGLE_CLIENT_ID=         # Google OAuth client ID — leave empty to disable Google sign-in
GOOGLE_CLIENT_SECRET=     # Google OAuth client secret
GOOGLE_REDIRECT_URI=      # Optional; defaults to <APP_URL or request origin>/api/auth/google/callback

# ── Translation (self-hosted sidecars) ───────────────────────────
# All optional — leave empty to disable the corresponding feature.
# See translate/docker-compose.yml for a ready-made stack.
LIBRETRANSLATE_URL=       # LibreTranslate REST base URL (e.g. http://localhost:5000) — text translation
WHISPER_URL=              # faster-whisper-server base URL (e.g. http://localhost:8000) — speech-to-text
PIPER_URL=                # Piper HTTP server base URL (e.g. http://localhost:5500) — text-to-speech (best-effort)
