# ═══════════════════════════════════════════════════════════════════
# Resonance — production environment for resonanse.app
# Copy to .env:   cp deploy/.env.production.example .env
#
# Legend:
#   [SECRET]   = never commit, never share, rotate if exposed
#   [PUBLIC]   = safe to expose (bundled into browser JS or public info)
#   [REQUIRED] = app will not boot/work correctly without it
#   [OPTIONAL] = feature degrades gracefully when empty
# ═══════════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────────
APP_ID=resonance                          # [PUBLIC]  [REQUIRED] app identifier
APP_SECRET=                               # [SECRET]  [REQUIRED] JWT signing key — generate: openssl rand -hex 32
APP_URL=https://resonanse.app             # [PUBLIC]  [REQUIRED] used for reset links + OAuth callback defaults

# ── Database (Supabase Postgres) ─────────────────────────────────
# 1. Create a free project at https://supabase.com (region closest to your VPS)
# 2. Dashboard → Project Settings → Database → Connection string → "Transaction" pooler
# 3. Paste it here (port 6543 — the app connects with prepare:false for pooler compatibility):
DATABASE_URL=                             # [SECRET]  [REQUIRED] postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Admin ────────────────────────────────────────────────────────
OWNER_UNION_ID=                           # [PRIVATE] [REQUIRED for admin] your user union ID — grants role "admin" at first login
ADMIN_EMAIL=                              # [PRIVATE] [OPTIONAL] email allowed to view treasury admin summary

# ── Email (Resend) — password reset + strike/removal notices ──────
RESEND_API_KEY=                           # [SECRET]  [OPTIONAL] from https://resend.com — empty = no emails sent (log only)
EMAIL_FROM=Resonance <no-reply@resonanse.app>   # [PUBLIC] sender — domain must be verified in Resend

# ── Google social login ──────────────────────────────────────────
GOOGLE_CLIENT_ID=                         # [PUBLIC]  [OPTIONAL] empty = Google button hidden
GOOGLE_CLIENT_SECRET=                     # [SECRET]  [OPTIONAL]
GOOGLE_REDIRECT_URI=                      # [PUBLIC]  [OPTIONAL] defaults to https://resonanse.app/api/auth/google/callback

# ── Smart Custody Wallet (watch-only deposit addresses) ──────────
# These are PUBLIC receiving addresses by design — the platform never
# custodies keys. Until you set real ones, deposits show "coming soon".
MERCHANT_XRP_ADDRESS=                     # [PUBLIC]  your XRP/RLUSD destination address
MERCHANT_BTC_ADDRESS=                     # [PUBLIC]  your BTC destination address

# ── Scam Shield threat feed ──────────────────────────────────────
URLHAUS_AUTH_KEY=                         # [SECRET]  [OPTIONAL] abuse.ch Auth-Key — empty = manual blocklist only

# ── Game voice (LiveKit) ─────────────────────────────────────────
LIVEKIT_URL=                              # [PUBLIC]  [OPTIONAL] wss://your-project.livekit.cloud
LIVEKIT_API_KEY=                          # [SECRET]  [OPTIONAL]
LIVEKIT_API_SECRET=                       # [SECRET]  [OPTIONAL]

# ── Translation sidecars (see translate/docker-compose.yml) ──────
LIBRETRANSLATE_URL=                       # [PUBLIC]  [OPTIONAL] http://127.0.0.1:5000
WHISPER_URL=                              # [PUBLIC]  [OPTIONAL] http://127.0.0.1:8000
PIPER_URL=                                # [PUBLIC]  [OPTIONAL] http://127.0.0.1:5500

# ── Kimi OAuth ───────────────────────────────────────────────────
# ⚠️  Kimi login works ONLY on the Kimi-hosted deployment. On your own
# domain these will not authenticate — users sign in with email/password
# (and Google, if configured). Left here for parity with the Kimi build.
VITE_KIMI_AUTH_URL=                       # [PUBLIC]  [OPTIONAL on VPS]
VITE_APP_ID=                              # [PUBLIC]  [OPTIONAL on VPS]
KIMI_AUTH_URL=                            # [PUBLIC]  [OPTIONAL on VPS]
KIMI_OPEN_URL=                            # [PUBLIC]  [OPTIONAL on VPS]

# ── Kalshi (public market data — no credentials, ever) ─────────
# No API key required — public endpoints only. Never put Kalshi credentials here.
KALSHI_REFERRAL_URL=                          # [PUBLIC]  [OPTIONAL] defaults to https://kalshi.com/r/492bccee-98d1-4164-9f7d-6cef7b2766f5
KALSHI_API_BASE=                              # [PUBLIC]  [OPTIONAL] defaults to https://external-api.kalshi.com/trade-api/v2
