# Publish-hardening: never run dependency lifecycle scripts during install.
# onnxruntime-node's postinstall downloads optional CUDA binaries from NuGet
# (fails in restricted build networks — its CPU binary is already bundled);
# esbuild's platform binary ships via @esbuild/* optional deps and sharp's via
# @img/* packages, so nothing in this project needs a postinstall to work.
ignore-scripts=true
